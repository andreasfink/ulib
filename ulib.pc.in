prefix=/usr/local
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Cflags: -I${includedir}
Libs:   -L${libdir} -lulib

Name: ulib
Description: universal library
Version: @VERSION@
Requires: openssl libzmq


